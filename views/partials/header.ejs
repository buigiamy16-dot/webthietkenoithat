<header class="site-header">
  <div class="container">
    <div class="header-content">
      <div class="logo">
        <a href="/">🏠 Nội Thất Cao Cấp</a>
      </div>
      
      <button class="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      
      <nav class="main-nav" id="mainNav">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Trang chủ</a>
        <% categories.forEach(cat => { %>
          <a href="/danh-muc/<%= cat.slug %>" 
             class="<%= currentPath.includes('/danh-muc/' + cat.slug) ? 'active' : '' %>">
            <%= cat.name %>
          </a>
        <% }) %>
        <a href="/blog" class="<%= currentPath.includes('/blog') ? 'active' : '' %>">📰 Blog</a>
        <a href="/lien-he" class="<%= currentPath === '/lien-he' ? 'active' : '' %>">Liên hệ</a>
        <a href="/admin/admin.html" class="admin-link">⚙️ Admin</a>
      </nav>
    </div>
  </div>
</header>